{
  "name": "keyboard-tester",
  "version": "0.1.0",
  "description": "키보드 테스트",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w uiohook-napi",
    "postinstall": "electron-rebuild -f -w uiohook-napi",
    "icon": "node build/generate-icon.mjs",
    "build": "electron-builder",
    "test": "node --test"
  },
  "keywords": [
    "keyboard",
    "tester",
    "electron",
    "uiohook"
  ],
  "author": "asdfghjkkl11",
  "license": "MIT",
  "build": {
    "appId": "com.keyboardtester.app",
    "productName": "키보드 테스트",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node",
      "node_modules/uiohook-napi/**"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "키보드테스트.exe"
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.2"
  },
  "dependencies": {
    "uiohook-napi": "^1.5.5"
  }
}
